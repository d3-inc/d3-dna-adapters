{
	admin off
	auto_https off
	# As behind a CDN or load balancer, so a spoofed X-Forwarded-Host is a real test.
	servers {
		trusted_proxies static 127.0.0.1/32
	}
	# As the landing-pages fleet takes it: a PROXY protocol hop names the address
	# that connected, so a test can connect from Cloudflare's.
	servers :8086 {
		listener_wrappers {
			proxy_protocol {
				allow 127.0.0.1/32
			}
		}
	}
}
import ../dna.caddy

# A bare site.
http://:8080 {
	invoke dna
	reverse_proxy http://127.0.0.1:3000
}

# Behind a PROXY protocol hop, as the fleet is.
http://:8086 {
	invoke dna
	reverse_proxy http://127.0.0.1:3000
}

# The shape the landing-pages fleet uses: try_files, then handle blocks.
http://:8085 {
	root * www
	invoke dna
	try_files {path} /index.html
	handle /api/* {
		reverse_proxy http://127.0.0.1:3000
	}
	handle {
		reverse_proxy http://127.0.0.1:3000
	}
}
